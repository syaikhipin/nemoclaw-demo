# Copy to .env and fill in. Never commit .env.
#
# LLM providers are OpenAI-compatible: each is just BASE_URL + API_KEY + MODEL.
# Point them at ANY OpenAI-compatible endpoint (custom proxies, local servers,
# other vendors) — only the three values change, no code changes needed.
#
# GLM on z.ai — primary LLM provider for now (NVIDIA NIM later).
GLM_API_KEY=
GLM_BASE_URL=https://api.z.ai/api/coding/paas/v4
GLM_MODEL=glm-5.3-flash
# NVIDIA NIM (build.nvidia.com) — used when GLM_API_KEY is unset.
NVIDIA_API_KEY=
# Model served by the NVIDIA NIM OpenAI-compatible endpoint.
# Hermes 3 is the model the Hermes agent was designed around; keep it unless you have a reason to switch.
NIM_MODEL=nousresearch/hermes-3-llama-3.1-70b
NIM_BASE_URL=https://integrate.api.nvidia.com/v1

# Exa — live web search for supplier discovery (Haggle phase).
EXA_API_KEY=<redacted>
# Optional: local SearXNG fallback when EXA_API_KEY is unset.
SEARXNG_URL=

# Use the deterministic offline stand-ins (no network, no key) for demo/CI.
REFLEX_OFFLINE=0

# Where the agent keeps its SQLite memory and artifacts.
REFLEX_HOME=~/.reflex

# Triage thresholds on the calibrated System One score.
REFLEX_SHORTLIST_AT=0.65
REFLEX_PASS_BELOW=0.35

# How many fresh products to scan per cycle.
REFLEX_SCAN_LIMIT=40
